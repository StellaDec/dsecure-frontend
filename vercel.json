      "permanent": true
    },
    {
      "source": "/blog/msp-erasure-service",
      "destination": "/blog/msp-data-erasure",
      "permanent": true
    },
    {
      "source": "/blog/data-deletion-myths",
      "destination": "/blog/data-erasure-myths",
      "permanent": true
    },
    {
      "source": "/blog/deleted-files-truth",
